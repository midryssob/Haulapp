{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hauling Pyro",
  "version": "1.4.0",
  "identifier": "cz.haulingpyro.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hauling Pyro",
        "width": 1200,
        "height": 860,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Hauling Pyro (fan tool)",
    "shortDescription": "Evidence nákladu a plánovač trasy pro Star Citizen – Pyro",
    "copyright": "Neoficiální fanouškovský nástroj, bez vazby na Cloud Imperium Games.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "Czech",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGRjE2QjUxRTM3OTQ1MjcKUldRblJYbmpVV3Z4SDc4anZZZm9hZTRsM0NFVEdUQkhtcjdFNlJodklVOFpLazIwcjM1VldqMjIK",
      "endpoints": [
        "https://github.com/midryssob/Haulapp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}